# Archivo de ejemplo para variables de entorno en Docker
# Copia este archivo a .docker.env y ajusta los valores

# URL de conexión a Neon PostgreSQL
# IMPORTANTE: La aplicación web SOLO usa Neon PostgreSQL, nunca SQLite
DATABASE_URL=postgresql://usuario:password@host:puerto/database?sslmode=require

# Deshabilitar telemetría de Next.js
NEXT_TELEMETRY_DISABLED=1

# Entorno
NODE_ENV=production

